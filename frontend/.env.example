# Frontend build-time environment (Vite). Copy to .env.local for local dev.

# Backend API base URL.
# Local dev:  http://127.0.0.1:8000/api/v1   (use 127.0.0.1, not localhost — see note below)
# Production: https://<your-render-service>.onrender.com/api/v1  (set in Netlify env vars)
VITE_API_URL=http://127.0.0.1:8000/api/v1

VITE_APP_NAME=PittCSC Alumni Network
VITE_ENV=development

# Note: locally, prefer 127.0.0.1 over localhost — some machines resolve `localhost`
# to IPv6 (::1) while the dev backend binds IPv4, which causes 404s.
