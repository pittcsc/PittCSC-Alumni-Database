# Backend environment (the FastAPI app reads the repo-root .env in local dev).
# In production these are set as real environment variables (e.g. Render dashboard),
# not from a file. Copy this to .env for local development.

# ---- Core ----
ENVIRONMENT=local                       # local | staging | production
SECRET_KEY=change-me-to-a-long-random-string   # REQUIRED in prod; keep stable so sessions survive restarts

# ---- Frontend / CORS ----
FRONTEND_HOST=http://localhost:5173
# Comma-separated extra origins allowed by CORS. In prod set to your site, e.g.
# BACKEND_CORS_ORIGINS=https://alumni.pittcs.wiki,https://<your-site>.netlify.app
BACKEND_CORS_ORIGINS=

# ---- Database ----
# Leave POSTGRES_SERVER unset to use local SQLite (zero-config dev).
# Set these to use Postgres (Render fills them in automatically via render.yaml):
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=alumni_db
# POSTGRES_USER=alumni_user
# POSTGRES_PASSWORD=change-me

# ---- First admin (seeded on startup) ----
FIRST_SUPERUSER=admin@pitt.edu
FIRST_SUPERUSER_PASSWORD=change-me
FIRST_SUPERUSER_NAME=PittCSC Admin

# ---- Email / SMTP ----
# REQUIRED IN PRODUCTION: email-OTP login emails the 6-digit code via SMTP.
# Without SMTP configured in prod, users cannot receive codes (password login still works).
# Leave blank locally — the OTP endpoint returns the code in its response (local only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=PittCSC Alumni Network
